{
  "schemaVersion": "1.0",
  "secretProviderOrder": ["browser-session", "environment", "os-credential-manager"],
  "services": {
    "crm": {
      "url": "https://crm.example.com/",
      "authMode": "browser-session-or-secret-ref",
      "usernameRef": "env:CRM_USERNAME",
      "passwordRef": "env:CRM_PASSWORD"
    },
    "mailbox": {
      "authMode": "platform-credential-store",
      "usernameRef": "env:SALES_EMAIL_USERNAME",
      "passwordRef": "env:SALES_EMAIL_PASSWORD"
    }
  }
}
