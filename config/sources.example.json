{
  "schemaVersion": "1.0",
  "profile": "generic-template",
  "sources": {
    "crm": {
      "type": "connector-or-browser",
      "location": "${CRM_BASE_URL}",
      "customerIdField": "customerId",
      "credentials": "platform-credential-store"
    },
    "productCatalog": [
      {
        "id": "live-product-api",
        "type": "api-or-cli",
        "location": "${PRODUCT_CATALOG_ENDPOINT}",
        "priority": 100,
        "containsInternalCost": true,
        "freshnessHours": 24
      },
      {
        "id": "approved-snapshot",
        "type": "json-file",
        "location": "${PRODUCT_CATALOG_JSON}",
        "priority": 60,
        "containsInternalCost": true,
        "freshnessHours": 720
      }
    ],
    "quoteBuilder": {
      "type": "web-or-api",
      "location": "${QUOTE_BUILDER_URL}"
    },
    "materialLibrary": [
      {
        "id": "exact-model-library",
        "type": "web-or-api",
        "location": "${MATERIAL_LIBRARY_URL}",
        "supports": ["image", "video", "datasheet"]
      }
    ],
    "freight": {
      "type": "manual-or-connector",
      "location": "${FREIGHT_CHANNEL}",
      "credentials": "platform-credential-store"
    }
  }
}
