{
  "schemaVersion": "1.0",
  "profile": "generic-template",
  "sources": {
    "crm": {
      "type": "connector-or-browser",
      "endpointRef": "env:CRM_BASE_URL",
      "customerIdField": "customerId",
      "credentials": "platform-credential-store"
    },
    "productCatalog": [
      {
        "id": "live-product-api",
        "type": "api-or-cli",
        "endpointRef": "env:PRODUCT_CATALOG_ENDPOINT",
        "priority": 100,
        "containsInternalCost": true,
        "freshnessHours": 24
      },
      {
        "id": "approved-snapshot",
        "type": "json-file",
        "pathRef": "env:PRODUCT_CATALOG_JSON",
        "priority": 60,
        "containsInternalCost": true,
        "freshnessHours": 720
      }
    ],
    "quoteBuilder": {
      "type": "web-or-api",
      "endpointRef": "env:QUOTE_BUILDER_URL"
    },
    "materialLibrary": [
      {
        "id": "exact-model-library",
        "type": "web-or-api",
        "endpointRef": "env:MATERIAL_LIBRARY_URL",
        "supports": ["image", "video", "datasheet"]
      }
    ],
    "freight": {
      "type": "manual-or-connector",
      "channelRef": "env:FREIGHT_CHANNEL",
      "credentials": "platform-credential-store"
    }
  }
}
