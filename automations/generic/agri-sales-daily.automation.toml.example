version = 1
id = "agri-sales-daily-generic"
kind = "cron"
name = "Agricultural sales daily review"
prompt = "Use $yiyunying-agri-auto-follow-generic and $yiyunying-agri-sales-distribution. Load the deployment source registry and current activation receipt. Start in dry-run mode unless the receipt explicitly authorizes this run. Audit new inbound messages and eligible customers, prepare a deduplicated queue, apply customer-language and outbound checks, and separate routine actions from confirmation-required quotation, PI, payment, certificate, tax, customs and freight actions. Verify each actual send and CRM write by read-back. Produce verified counts, exceptions, confirmation queues and the next ledger cursor."
status = "PAUSED"
rrule = "RRULE:FREQ=WEEKLY;BYHOUR=7;BYMINUTE=0;BYDAY=MO,TU,WE,TH,FR"
execution_environment = "local"

