{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential Bindings",
  "type": "object",
  "required": ["schemaVersion", "services"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "secretProviderOrder": {
      "type": "array",
      "items": { "enum": ["browser-session", "environment", "os-credential-manager", "platform-credential-store", "desktop-session"] }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["authMode"],
        "properties": {
          "url": { "type": "string" },
          "urlTemplate": { "type": "string" },
          "authMode": { "type": "string" },
          "usernameRef": { "type": ["string", "null"] },
          "passwordRef": { "type": ["string", "null"] },
          "tokenRef": { "type": ["string", "null"] }
        },
        "patternProperties": {
          "^[A-Za-z][A-Za-z0-9]*Ref$": {
            "type": ["string", "null"],
            "pattern": "^(env|credential-manager|platform):[^\\s]+$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
