{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shanheshile/yiyunying-agri-sales/main/schemas/source-registry.schema.json",
  "title": "Sales source registry",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "profile": { "type": "string" },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/source" },
          { "type": "array", "items": { "$ref": "#/$defs/source" } }
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type"],
      "anyOf": [
        { "required": ["location"] },
        { "required": ["endpointRef"] },
        { "required": ["pathRef"] },
        { "required": ["channelRef"] },
        { "required": ["binding"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "endpointRef": { "type": "string", "pattern": "^(env|credential-manager|platform):[^\\s]+$" },
        "pathRef": { "type": "string", "pattern": "^(env|credential-manager|platform):[^\\s]+$" },
        "channelRef": { "type": "string", "pattern": "^(env|credential-manager|platform):[^\\s]+$" },
        "binding": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "freshnessHours": { "type": ["integer", "null"], "minimum": 0 },
        "containsInternalCost": { "type": "boolean" },
        "credentials": { "type": "string", "enum": ["none", "environment", "platform-credential-store"] },
        "supports": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
