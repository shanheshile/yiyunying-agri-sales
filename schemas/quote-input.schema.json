{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shanheshile/yiyunying-agri-sales/main/schemas/quote-input.schema.json",
  "title": "Quotation calculation input",
  "type": "object",
  "required": ["customerId", "currency", "incoterm", "pricingMode", "profitRate", "items", "exchangeRates"],
  "properties": {
    "customerId": { "type": "string" },
    "currency": { "type": "string" },
    "incoterm": { "type": "string" },
    "pricingMode": { "enum": ["markup-on-cost", "gross-margin-on-sale", "backend-calculated"] },
    "profitRate": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
    "backendTotal": { "type": ["number", "null"], "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "model", "quantity", "unitCost", "costCurrency", "imageVerified"],
        "properties": {
          "productId": { "type": "string" },
          "model": { "type": "string" },
          "configuration": { "type": ["string", "null"] },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitCost": { "type": "number", "minimum": 0 },
          "costCurrency": { "type": "string" },
          "imageVerified": { "const": true }
        }
      }
    },
    "termCosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "amount", "currency", "sourceId"],
        "properties": {
          "name": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string" },
          "sourceId": { "type": "string" }
        }
      }
    },
    "exchangeRates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "rate", "observedAt", "source"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "rate": { "type": "number", "exclusiveMinimum": 0 },
          "observedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string" }
        }
      }
    },
    "humanConfirmationRequired": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "pricingMode": { "const": "backend-calculated" } } },
      "then": { "required": ["backendTotal"] }
    }
  ],
  "additionalProperties": true
}
